# Copy to `.env` and fill in. `.env` is git-ignored; this file is not.
#
# Only MCP_API_KEY is a credential. Everything else is configuration.

# Required when MCP_TRANSPORT=sse. The server exits at startup if it is unset —
# there is no implicit "auth disabled" mode for the network transport.
# Generate with: openssl rand -hex 32
MCP_API_KEY=replace-me-with-a-random-32-byte-hex-string

# stdio (default, Claude Desktop) | sse | streamable-http
MCP_TRANSPORT=stdio

# HTTP binding, network transports only. Defaults to loopback; set 0.0.0.0
# deliberately when running inside a container with a published port.
MCP_HOST=127.0.0.1
PORT=8000

# Rate limiting for the SSE transport: requests per window, window in seconds.
MCP_RATE_LIMIT=60
MCP_RATE_WINDOW=60

# DEBUG | INFO | WARNING | ERROR. Structured JSON, one object per line, on stderr.
LOG_LEVEL=INFO

# Comma-separated egress allow-list. An override REPLACES the default entirely
# and must include the gazette host. See docs/network-egress.md.
# MCP_ALLOWED_HOSTS=amtsblattportal.ch,www.amtsblattportal.ch
